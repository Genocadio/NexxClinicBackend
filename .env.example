# ============================================================================
# NexxClinic Backend Docker Environment — Copy to .env and customize
# ============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=nexxclinic
POSTGRES_USER=nexxclinic_user
POSTGRES_PASSWORD=nexxclinic_pass

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_PORT=7700
MEILI_MASTER_KEY=nexxclinic_meili_master_key
MEILI_ENV=development

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=nexxclinic-local-dev-jwt-secret-change-in-production-32b
JWT_EXPIRATION_MINUTES=480
JWT_REFRESH_EXPIRATION_DAYS=30
SPRING_PROFILES_ACTIVE=
JAVA_OPTS=-Xmx512m -Xms256m

# ── Storage ───────────────────────────────────────────────────────────────────
# LOCAL: files saved to disk, served by backend /api/media/
# SUPABASE: files uploaded to self-hosted Supabase Storage
STORAGE_TYPE=LOCAL

# ── Supabase (only needed when STORAGE_TYPE=SUPABASE) ────────────────────────
# SUPABASE_URL=https://supa.med.rw
# SUPABASE_SERVICE_KEY=your-service-role-key
