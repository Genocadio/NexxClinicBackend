  status: VisitProductStatus
}

input CreateVisitDepartmentProductInput {
  visitId: ID!
  departmentId: ID!
  productId: ID!
  processorId: ID
  quantity: Float
  status: VisitProductStatus
}

input AddChildVisitDepartmentProductInput {
  productId: ID!
  quantity: Float!
}

"""
Input for adding a child visit department with products.
All validations occur before the child department is created:
- All products must exist and be valid
- processorId is required if the department has multiple processors or supportRequests is enabled
- If any product cannot be added, the child department is NOT created
- A child department with 0 products will never exist; it is deleted if the last product is removed
- profileId is reserved and rejected: child departments always support requests,
  and profiles can only be set on departments that do not support requests
"""
input AddChildVisitDepartmentInput {
  parentVisitDepartmentId: ID!
  departmentId: ID!
  products: [AddChildVisitDepartmentProductInput!]
  profileId: ID
  processorId: ID
  encounterType: EncounterType
}

input UpdateVisitDepartmentProductStatusInput {
  visitDepartmentProductId: ID!
  status: VisitProductStatus!
}

input UpdateVisitDepartmentProductProcessorInput {
  """ID of the visit-department-product whose processor to change."""
  visitDepartmentProductId: ID!
  """
  ID of the worker to assign as processor. Pass null to clear.
  - FINANCE/ADMIN may assign any worker.
  - Others may only pick from the visit department's existing processors.
  - Only the worker who originally added the product may change it (ownership guard),
    unless the caller is FINANCE or ADMIN.
  """
  processorId: ID
}

input UpdateVisitDepartmentStatusInput {
  visitDepartmentId: ID!
  status: VisitDepartmentStatus!
}

input UpdateVisitDepartmentProductQuantityInput {
  visitDepartmentProductId: ID!
  quantity: Float!
}

input BillVisitDepartmentProductInput {
  visitDepartmentProductId: ID!
  parentVisitDepartmentId: ID
  quantity: Float
  coverageType: CoverageType!
  patientInsuranceId: ID
  """NONE, PATIENT_SHARE (patient waive, insurance still pays), or FULL (entire line zeroed)."""
  exemptionType: ExemptionType
  """Override the resolved patient share % for this line. Null = use rule/provider default."""
  patientSharePercentageOverride: Int
}

input EditBillVisitBillProductInput {
  productId: ID!
  patientInsuranceId: ID
  coverageType: CoverageType!
  quantity: Float
  """NONE, PATIENT_SHARE (patient waive, insurance still pays), or FULL (entire line zeroed)."""
  exemptionType: ExemptionType
  """Override the resolved patient share % for this line. Null = use rule/provider default."""
  patientSharePercentageOverride: Int
}

input BillingPaymentInput {
  amount: Float!
  paymentMethod: PaymentMethod!
  reference: String
}

input BillVisitDepartmentInput {
  visitDepartmentId: ID!
  products: [BillVisitDepartmentProductInput!]!
  payments: [BillingPaymentInput!]
  """
  Required when any product has exemptionType != NONE or the patient payment
  does not cover the full payable amount. Optional otherwise.
  """
  note: String
  """LOAN if patient owes, GIVEAWAY if clinic absorbs the outstanding balance."""
  outstandingType: String
  """Free-text reason for the loan or giveaway."""
  outstandingReason: String
}

input BillVisitInput {
  visitId: ID!
  departments: [BillVisitDepartmentInput!]!
}

"""
Edit billing (error correction):
- Applies add/remove/update to visit department products first
- Then creates a new immutable billing version
"""
input EditBillVisitInput {
  visitId: ID!
  departments: [EditBillVisitDepartmentInput!]!
}

input EditBillVisitDepartmentInput {
  visitDepartmentId: ID!

  addedProducts: [EditBillVisitAddProductInput!]
  removedProductIds: [ID!]
  updatedProducts: [EditBillVisitUpdateProductInput!]

  """Billing selections for the new version (by productId; backend maps to visitDepartmentProductId)"""
  billProducts: [EditBillVisitBillProductInput!]!
  payments: [BillingPaymentInput!]
  note: String
  outstandingType: String
  outstandingReason: String
}

input EditBillVisitAddProductInput {
  productId: ID!
  quantity: Float!
  processorId: ID
}

input EditBillVisitUpdateProductInput {
  productId: ID!
  quantity: Float
}

input RecordVisitBillingPaymentInput {
  departmentInsuranceBillingId: ID!
  amount: Float!
  paymentMethod: PaymentMethod!
  reference: String
  """
  Required when the payment does not fully cover the outstanding patient payable amount.
  Optional otherwise.
  """
  note: String
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  CHEQUE
  MIXED
}

