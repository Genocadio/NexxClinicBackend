type InsuranceCoverage {
  id: ID!
  insuranceProviderId: ID!
  insuranceProviderName: String!
  departmentId: ID
  departmentName: String
  encounterType: EncounterType
  patientSharePercentage: Int!
  createdAt: String!
  updatedAt: String!
}

type InsuranceCoverageResponse implements ApiResponse {
  status: ResponseStatus!
  message: String
  data: InsuranceCoverage
}

type InsuranceCoverageListResponse implements ApiResponse {
  status: ResponseStatus!
  message: String
  data: [InsuranceCoverage!]
}

input CreateInsuranceCoverageInput {
  insuranceProviderId: ID!
  departmentId: ID
  encounterType: EncounterType
  """Patient share percentage (0-100). Insurance covers (100 - X)%."""
  patientSharePercentage: Int!
}

input UpdateInsuranceCoverageInput {
  insuranceProviderId: ID
  departmentId: ID
  encounterType: EncounterType
  patientSharePercentage: Int
}

input SearchInsuranceCoveragesInput {
  insuranceProviderId: ID
  departmentId: ID
}

type Query {
  me: WorkerResponse!
  listUsers: WorkerListResponse!
  searchWorkers(name: String, role: RoleName, activeOnly: Boolean, departmentId: ID): WorkerListResponse!
  adminAuditLogs: AuditLogListResponse!
  insuranceProvider(insuranceProviderId: ID!): InsuranceProviderResponse!
  insuranceProviders(input: SearchInsuranceProvidersInput): PaginatedInsuranceProviderResponse!
  patient(patientId: ID!): PatientResponse!
  patients: PaginatedPatientResponse!
  patientInsurances(patientId: ID!): PaginatedPatientInsuranceResponse!
  searchPatients(input: SearchPatientsInput): PaginatedPatientResponse!
  product(productId: ID!): ProductResponse!
  products(input: SearchProductsInput): PaginatedProductResponse!
  productInsuranceCoverage(productInsuranceCoverageId: ID!): ProductInsuranceCoverageResponse!
  department(departmentId: ID!): DepartmentResponse!
  departments(input: SearchDepartmentsInput): PaginatedDepartmentResponse!
  visit(visitId: ID!): VisitResponse!
  visits(input: SearchVisitsInput): PaginatedVisitResponse!
  getPatientHistory(patientId: ID!, input: SearchPatientHistoryInput): PaginatedVisitResponse!
  visitDepartmentNotes(visitId: ID!, visitDepartmentId: ID): VisitDepartmentNotesListResponse!
  visitBilling(visitId: ID!): VisitBillingResponse!
  clinicProfile: ClinicProfileResponse!
  lastPatientDepartmentVisit(visitId: ID!, departmentId: ID!): LastPatientDepartmentVisitResponse!
  insuranceCoverage(ruleId: ID!): InsuranceCoverageResponse!
  insuranceCoverages(input: SearchInsuranceCoveragesInput): InsuranceCoverageListResponse!
}

type Mutation {
  selfRegister(input: SelfRegisterInput!): WorkerResponse!
  adminCreateUser(input: AdminCreateUserInput!): WorkerResponse!
  adminUpdateUser(userId: ID!, input: AdminUpdateUserInput!): WorkerResponse!
  activateUser(input: ActivateUserInput!): WorkerResponse!
  deactivateUser(input: DeactivateUserInput!): WorkerResponse!
  login(input: LoginInput!): AuthResponse!
  setInitialPassword(input: SetInitialPasswordInput!): BooleanResponse!
  refreshSession(input: RefreshSessionInput!): AuthResponse!
  refreshToken(input: RefreshTokenInput!): AuthResponse!
  logout(input: LogoutInput): BooleanResponse!
  updateMyProfile(input: UpdateMyProfileInput!): WorkerResponse!
  changeMyPassword(input: ChangeMyPasswordInput!): BooleanResponse!
  adminTriggerPasswordReset(input: AdminTriggerPasswordResetInput!): BooleanResponse!
  adminSetUserSessionLimit(input: AdminSetUserSessionLimitInput!): BooleanResponse!
  createInsuranceProvider(input: CreateInsuranceProviderInput!): InsuranceProviderResponse!
  updateInsuranceProvider(insuranceProviderId: ID!, input: UpdateInsuranceProviderInput!): InsuranceProviderResponse!
  deleteInsuranceProvider(insuranceProviderId: ID!): BooleanResponse!
  createPatient(input: CreatePatientInput!): VisitResponse!
  updatePatient(patientId: ID!, input: UpdatePatientInput!): PatientResponse!
  deletePatient(patientId: ID!): BooleanResponse!
  createPatientInsurance(input: CreatePatientInsuranceInput!): PatientInsuranceResponse!
  updatePatientInsurance(patientInsuranceId: ID!, input: UpdatePatientInsuranceInput!): PatientInsuranceResponse!
  deletePatientInsurance(patientInsuranceId: ID!): BooleanResponse!
  createProduct(input: CreateProductInput!): ProductResponse!
  updateProduct(productId: ID!, input: UpdateProductInput!): ProductResponse!
  createProductInsuranceCoverage(productId: ID!, input: CreateProductInsuranceCoverageInput!): ProductInsuranceCoverageResponse!
  updateProductInsuranceCoverage(productInsuranceCoverageId: ID!, input: UpdateProductInsuranceCoverageInput!): ProductInsuranceCoverageResponse!
  deleteProductInsuranceCoverage(productInsuranceCoverageId: ID!): BooleanResponse!
  createDepartment(input: CreateDepartmentInput!): DepartmentResponse!
  updateDepartment(departmentId: ID!, input: UpdateDepartmentInput!): DepartmentResponse!

  """
  Removes a department profile. Profiles are extra objects: they are added/updated
  through createDepartment/updateDepartment and never deleted implicitly by an
  update. This mutation is the only way to delete one. A profile still in use by a
  visit department cannot be removed — switch those visits to another profile first.
  """
  removeDepartmentProfile(profileId: ID!): DepartmentResponse!
  createVisit(input: CreateVisitInput!): VisitResponse!
  changeVisitDate(input: ChangeVisitDateInput!): VisitResponse!

  """
  Add a department to a visit. The department's default profile is NEVER
  auto-applied — a profile is set only when an explicit profileId is provided,
  and only on departments that do not support requests. Without a profileId the
  visit department is created without a profile (add products manually or change
  the profile later via changeVisitDepartmentProfile).
  """
  addVisitDepartment(visitId: ID!, departmentId: ID!, profileId: ID, encounterType: EncounterType, processorId: ID): VisitResponse!

  """
  Set (or clear) the profile used by a visit department, swapping its
  PROFILE-sourced products for the new profile's products (USER products are
  kept). Profile products cannot be removed individually — this is the only way
  to replace them. Profiles can only be set on departments that do not support
  requests. Pass no profileId to clear the profile.
  """
  changeVisitDepartmentProfile(visitDepartmentId: ID!, profileId: ID): VisitDepartmentResponse!

  """
  Add a child visit department with products. Validations occur before creation:
  - If any product validation fails, the child department is NOT created
  - Child departments can be created without processorId and assigned later
  - Child departments can never exist with zero products
  """
  addChildVisitDepartment(input: AddChildVisitDepartmentInput!): VisitDepartmentResponse!
  removeChildVisitDepartment(visitDepartmentId: ID!): VisitDepartmentResponse!
  """Remove a top-level visit department from a visit. Only allowed when the department has 0 products."""
  removeVisitDepartment(visitDepartmentId: ID!): VisitResponse!
  addVisitDepartmentProcessor(visitDepartmentId: ID!, processorId: ID!): VisitDepartmentResponse!
  removeVisitDepartmentProcessor(visitDepartmentId: ID!, processorId: ID!): VisitDepartmentResponse!
  linkVisitInsurances(visitId: ID!, insuranceIds: [ID!]!): VisitResponse!
  unlinkVisitInsurances(visitId: ID!, insuranceIds: [ID!]!): VisitResponse!
  completeVisitDepartment(visitDepartmentId: ID!): VisitDepartmentResponse!
  addVisitDepartmentProduct(input: CreateVisitDepartmentProductInput!): VisitDepartmentResponse!
  """Change (or clear) the processor on an existing visit-department product."""
  updateVisitDepartmentProductProcessor(input: UpdateVisitDepartmentProductProcessorInput!): VisitDepartmentResponse!
  updateVisitDepartmentProductStatus(input: UpdateVisitDepartmentProductStatusInput!): VisitDepartmentResponse!
  updateVisitDepartmentStatus(input: UpdateVisitDepartmentStatusInput!): VisitDepartmentResponse!
  updateVisitDepartmentProductQuantity(input: UpdateVisitDepartmentProductQuantityInput!): VisitDepartmentResponse!
  updateVisitDepartmentEncounterType(visitDepartmentId: ID!, encounterType: EncounterType!): VisitDepartmentResponse!
  completeConsultationVisit(input: ConsultationAnswersInput!, final: Boolean!): VisitResponse!
  completeVisit(visitId: ID!): VisitResponse!
  removeVisitDepartmentProduct(visitDepartmentProductId: ID!): VisitDepartmentResponse!
  billVisit(input: BillVisitInput!): VisitBillingResponse!
  editBillVisit(input: EditBillVisitInput!): VisitBillingResponse!
  recordVisitBillingPayment(input: RecordVisitBillingPaymentInput!): VisitBillingResponse!
  generateInvoice(departmentInsuranceBillingId: ID!): InvoiceResponse!
  flushSoftDeletedVisitProducts(visitId: ID!): BooleanResponse!
  cancelVisit(visitId: ID!): VisitResponse!

  # ── Bill Editing Mode ────────────────────────────────────────────────────
  """Enter BILL_EDITING mode on a COMPLETED visit to allow billing corrections."""
  startBillEditing(visitId: ID!): BillEditingResponse!
  """Exit BILL_EDITING mode and lock billing back to COMPLETED."""
  completeBillEditing(visitId: ID!): BillEditingResponse!
  """Exit BILL_EDITING mode without saving (user cancelled the edit)."""
  cancelBillEditing(visitId: ID!): BillEditingResponse!
  updateClinicProfile(input: UpdateClinicProfileInput!): ClinicProfileResponse!
  deleteClinicProfile: BooleanResponse!
  reindexSearchIndexes(indexes: [SearchIndexType!]!): BooleanResponse!
  createInsuranceCoverage(input: CreateInsuranceCoverageInput!): InsuranceCoverageResponse!
  updateInsuranceCoverage(ruleId: ID!, input: UpdateInsuranceCoverageInput!): InsuranceCoverageResponse!
  deleteInsuranceCoverage(ruleId: ID!): BooleanResponse!
}
