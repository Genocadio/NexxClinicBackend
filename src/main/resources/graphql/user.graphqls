}

input CreateVisitDepartmentInput {
  departmentId: ID!
  encounterType: EncounterType
  profileId: ID
  processorId: ID
  products: [CreateVisitDepartmentProductItemInput!]
}

input CreateVisitDepartmentProductItemInput {
  productId: ID!
  processorId: ID
