scalar JSON

enum ResponseStatus {
  SUCCESS
  ERROR
  UNAUTHENTICATED
  UNAUTHORISED
  PARTIAL_SUCCESS
}

enum RoleName {
  MANAGER
  CLINIC_ADMIN
  FINANCE
  STAFF
  RECEPTION
  NURSE
  CLINICIAN
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DocumentType {
  LICENSE
  DIPLOMA_CERTIFICATE
  DEGREE_CERTIFICATE
  TRAINING_CERTIFICATE
  NATIONAL_ID
  PASSPORT
  BACKGROUND_CHECK
  WORK_PERMIT
  OTHER
}

enum ProductType {
  DRUG
  MEDICAL_ACT
  BIOLOGICAL_ACT
  CONSUMABLE_DEVICE
}

enum ProductUnit {
  TABLET
  CAPSULE
  PESSARY
  SUPPOSITORY
  BOX_OF_6_TABLETS
  BOX_OF_7_PESSARIES
  BOX_OF_9_TABLETS
  BOX_OF_12_TABLETS
  BOX_OF_12_PESSARIES
  BOX_OF_14_TABLETS
  BOX_OF_18_TABLETS
  BOX_OF_18_PESSARIES
  BOX_OF_24_TABLETS
  BOX_OF_1_PESSARY
  BOX_OF_3_PESSARIES
  BOX_OF_6_PESSARIES
  BOTTLE
  VIAL
  AMPOULE
  TUBE
  TUBE_OF_15_TABLETS
  TUBE_OF_20_TABLETS
  TUBE_OF_50_STRIPS
  BOX
  SACHET
  POT
  ROLL
  PIECE
  DOSE
  KIT_OF_ONE_DAY_DOSE
  PCS
  UNKNOWN
}

enum MustPrescribedBy {
  ALL
}

enum DrugAdministrationFrequency {
  CUSTOM_HOURS
}

enum DepartmentInsurancePolicyMode {
  ALL
  ONLY
  EXCEPT
}

enum VisitStatus {
  CREATED
  IN_PROGRESS
  CANCELLED
  COMPLETED
  BILL_EDITING
}

enum VisitProductStatus {
  BILLED
  EXEMPTED
  """
  The patient's share was waived but insurance still covers its normal amount.
  Distinct from EXEMPTED where the entire line is zeroed.
  """
  PATIENT_SHARE_EXEMPTED
  """
  Was BILLED/EXEMPTED/PATIENT_SHARE_EXEMPTED and reset by the edit-billing correction flow.
  Transient within the correction transaction; not settable by clients.
  """
  CORRECTION_PENDING
  UNPAID
  PENDING
}

"""
How a visit department product was added:
- USER: added manually through the normal add-product flow
- PROFILE: auto-added from a department profile (cannot be removed individually — change the visit department's profile instead)
"""
enum VisitDepartmentProductSource {
  USER
  PROFILE
}

enum VisitDepartmentStatus {
  ACTIVE
  PENDING
  ON_HOLD
  BILLING
  COMPLETED
  FINALISED
  CANCELLED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT_OBSERVATION
  INPATIENT_ADMISSION
  FOLLOWUP
}

"""
Meilisearch indexes that can be rebuilt via reindexSearchIndexes.
"""
enum SearchIndexType {
  PRODUCTS
  PATIENTS
  WORKERS
}

enum VisitBillingStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

"""
How a billed product line is covered. There is NO automatic insurance assignment
per product — each line must be explicit:
- PRIVATE: billed without insurance; patientInsuranceId must NOT be provided.
- INSURANCE: billed against an explicit insurance; patientInsuranceId is
  required and must be linked to the visit, belong to the visit's patient,
  be active (policy period covers today) and cover the product.
"""
enum CoverageType {
  PRIVATE
  INSURANCE
}

"""
Defines how a billing product line is exempted from patient payment.
- NONE: no exemption; the patient pays their share
- PATIENT_SHARE: the patient's share is waived; insurance still covers its normal amount
- FULL: the entire line is zeroed (unit price, insurance, patient amount all zero)
"""
enum ExemptionType {
  NONE
  PATIENT_SHARE
  FULL
}

"""
Indicates the source of the patient share percentage applied to a billing line.
"""
enum PatientShareSource {
  OVERRIDE
  RULE
  PATIENT_DEFAULT
  PROVIDER_DEFAULT
  EXEMPTED
}

enum ClinicContactType {
  PHONE
  EMAIL
  POBOX
}

enum FormStatus {
  DRAFT
  FINAL
}

enum FieldType {
  text
  email
  number
  date
  textarea
  actionListener
  select
  radio
  checkbox
  table
  labRecord
  signature
  file
  heading
  paragraph
  diagnosticRecord
  medicationLongForm
  medicationMiniForm
}

enum TableMode {
  STATIC
  DYNAMIC
}

enum ConditionalCondition {
  equals
  not_equals
  contains
  not_contains
  greater_than
  less_than
  is_empty
  is_not_empty
  hasItem
}



enum AnswerStatus {
  DRAFT
  FINAL
  SUBMITTED
}

interface ApiResponse {
  status: ResponseStatus!
  message: String
  }

